# ---------------------------------------------------------------------------
# The Matcha Kyoto Ops — contoh environment variable
# Salin file ini menjadi `.env.local`, lalu isi dengan nilai proyek Supabase Anda.
# JANGAN pernah commit `.env.local` ke repository.
# ---------------------------------------------------------------------------

# URL proyek Supabase. Contoh: https://abcdefghijklmnop.supabase.co
# Aman diekspos ke browser.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key Supabase (Project Settings -> API Keys).
# Aman diekspos ke browser: kunci ini selalu tunduk pada Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL dasar aplikasi, dipakai untuk membangun link absolut.
# Development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# RAHASIA — HANYA SERVER
# ---------------------------------------------------------------------------
# JANGAN memberi awalan NEXT_PUBLIC_ pada nilai di bawah ini.
# Service role key MELEWATI seluruh Row Level Security. Jangan pernah
# mengimpornya dari komponen klien, dan jangan menaruhnya di repo.
#
# Tahap 1 TIDAK membutuhkan service role key sama sekali. Biarkan kosong
# kecuali Anda menambahkan tugas administratif khusus server pada tahap lanjut.
SUPABASE_SERVICE_ROLE_KEY=

# Batas percobaan login (proteksi brute force sederhana, in-memory).
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_BLOCK_SECONDS=900
